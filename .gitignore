# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# Model weights (AGPL-3.0 for YOLO; SAM 3 weights live outside the repo)
yolov8n.pt
*.pt

# OS / editor
.DS_Store
.idea/
.vscode/

# Review scratch space used during development
.review/

# Footage
#
# data/footage/*.mp4 is intentionally NOT committed.
#   * Clip 01 (Pexels) is redistributable but large.
#   * Clips 02-05 (MOTChallenge) are CC BY-NC-SA 3.0: NON-COMMERCIAL, NO REDISTRIBUTION.
#     Committing them to a public repository would breach that licence.
# See THIRD_PARTY.md for how to obtain them and how to remove them before release.
data/footage/*.mp4
data/footage/*.webm

# Generated analysis and rendered keyframes
#
# output/keyframes/01_* (Pexels, redistributable) IS committed: it is the measured
# evidence and the dashboard is meaningless without it.
#
# The other four keyframe sets are RENDERS OF MOTChallenge footage. Those clips are
# CC BY-NC-SA 3.0 (non-commercial, no redistribution), so committing derived frames
# would redistribute the material just as surely as committing the videos. They are
# excluded; regenerate locally with: python3 scripts/analyze_footage.py
output/keyframes/02_*/
output/keyframes/03_*/
output/keyframes/04_*/
output/keyframes/05_*/

# data/analysis/ records measurements only - numbers, not imagery - so it is committed
# for all clips.

# Segmentation weights (download-on-first-use, AGPL-3.0 - see THIRD_PARTY.md)
*-seg.pt
yolo11*.pt
